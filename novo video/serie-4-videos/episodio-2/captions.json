[
  {
    "start": 0.2936,
    "end": 4.4971,
    "text": "Por que o alerta chegou agora?"
  },
  {
    "start": 4.4971,
    "end": 6.7873,
    "text": "Estamos na época de menos chuva."
  },
  {
    "start": 7.2971,
    "end": 11.7475,
    "text": "Com menos chuva, a vegetação fica mais"
  },
  {
    "start": 11.7475,
    "end": 13.7765,
    "text": "seca."
  },
  {
    "start": 13.7765,
    "end": 17.7199,
    "text": "O fogo encontra mais condições para se"
  },
  {
    "start": 18.2931,
    "end": 24.4606,
    "text": "Os satélites registram pontos de calor. Cada"
  },
  {
    "start": 24.4606,
    "end": 28.4713,
    "text": "ponto é um foco detectado, não um"
  },
  {
    "start": 32.2934,
    "end": 34.915,
    "text": "Em dois mil e vinte e seis"
  },
  {
    "start": 34.915,
    "end": 37.3375,
    "text": "há El Niño."
  },
  {
    "start": 37.3375,
    "end": 41.313,
    "text": "Ele pode reduzir as chuvas e favorecer"
  },
  {
    "start": 44.2929,
    "end": 48.7291,
    "text": "Mas o clima não explica tudo."
  },
  {
    "start": 48.7291,
    "end": 50.9086,
    "text": "A origem do fogo também importa."
  },
  {
    "start": 53.2971,
    "end": 57.5133,
    "text": "Agora, vamos aproximar o mapa e olhar"
  },
  {
    "start": 57.5133,
    "end": 57.9717,
    "text": "o Xingu."
  }
]