[
  {
    "start": 0.3410979948402593,
    "end": 4.157356517309732,
    "text": "Por que falar de fogo agora?"
  },
  {
    "start": 4.157356517309732,
    "end": 7.47,
    "text": "Na estiagem, a vegetação fica mais vulnerável."
  },
  {
    "start": 8.357062500000001,
    "end": 14.019875,
    "text": "Estes mapas mostram focos de calor detectados nos"
  },
  {
    "start": 14.019875,
    "end": 20.26775,
    "text": "municípios da Amazônia Legal, em setembro e outubro,"
  },
  {
    "start": 20.26775,
    "end": 23.244187500000002,
    "text": "de dois mil e vinte a dois mil"
  },
  {
    "start": 23.244187500000002,
    "end": 26.292812500000004,
    "text": "e vinte e seis."
  },
  {
    "start": 26.292812500000004,
    "end": 29.83,
    "text": "As cores mostram como os registros variam entre"
  },
  {
    "start": 30.331478882349135,
    "end": 33.31338299794645,
    "text": "O El Niño pode reduzir as chuvas em"
  },
  {
    "start": 33.31338299794645,
    "end": 37.5197349682265,
    "text": "partes da Amazônia e favorecer condições para o"
  },
  {
    "start": 37.5197349682265,
    "end": 40.31991394678546,
    "text": "fogo se espalhar."
  },
  {
    "start": 40.31991394678546,
    "end": 42.83,
    "text": "Em outubro de dois mil e vinte e"
  },
  {
    "start": 43.34860541207377,
    "end": 47.31082509171951,
    "text": "Mas ele não explica tudo."
  },
  {
    "start": 47.31082509171951,
    "end": 51.341610139156344,
    "text": "A origem do fogo e as condições locais"
  },
  {
    "start": 51.341610139156344,
    "end": 52.47,
    "text": "também precisam ser consideradas."
  },
  {
    "start": 53.3570625,
    "end": 57.370875,
    "text": "Agora vamos aproximar o mapa e olhar os"
  },
  {
    "start": 57.370875,
    "end": 59.18834467120181,
    "text": "dias de maior pico no Xingu."
  }
]