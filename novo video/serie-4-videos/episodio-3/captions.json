[
  {
    "start": 0.3529375,
    "end": 5.5776875,
    "text": "No Xingu, alguns dias tiveram muito mais focos"
  },
  {
    "start": 5.5776875,
    "end": 5.973333333333333,
    "text": "do que outros."
  },
  {
    "start": 8.316153976169486,
    "end": 11.976433970179405,
    "text": "O recorte reúne dez municípios."
  },
  {
    "start": 11.976433970179405,
    "end": 14.47,
    "text": "Selecionamos os três maiores picos de cada mês."
  },
  {
    "start": 15.351769502791182,
    "end": 17.680210506552182,
    "text": "Treze de setembro:"
  },
  {
    "start": 17.680210506552182,
    "end": 19.47,
    "text": "cento e um focos."
  },
  {
    "start": 20.342001781244953,
    "end": 22.86843447238818,
    "text": "Vinte e um de setembro:"
  },
  {
    "start": 22.86843447238818,
    "end": 24.47,
    "text": "cento e quarenta e nove."
  },
  {
    "start": 25.357062499999998,
    "end": 28.346999999999998,
    "text": "Vinte e seis de setembro:"
  },
  {
    "start": 28.346999999999998,
    "end": 29.445850340136055,
    "text": "cento e oito."
  },
  {
    "start": 30.33567842439614,
    "end": 32.06568539426402,
    "text": "Nove de outubro:"
  },
  {
    "start": 32.06568539426402,
    "end": 34.47,
    "text": "trezentos e trinta e seis focos."
  },
  {
    "start": 35.351250345209415,
    "end": 37.41397584093013,
    "text": "Doze de outubro:"
  },
  {
    "start": 37.41397584093013,
    "end": 39.47,
    "text": "trezentos e quatorze."
  },
  {
    "start": 40.33196852662032,
    "end": 42.823766052009326,
    "text": "Vinte e cinco de outubro:"
  },
  {
    "start": 42.823766052009326,
    "end": 44.47,
    "text": "duzentos e noventa e sete."
  },
  {
    "start": 45.33833038117986,
    "end": 49.86266533507323,
    "text": "Em nove de outubro, Altamira registrou cento e"
  },
  {
    "start": 49.86266533507323,
    "end": 52.61276542176321,
    "text": "quatro focos."
  },
  {
    "start": 52.61276542176321,
    "end": 53.47,
    "text": "Focos não medem área queimada."
  },
  {
    "start": 54.35015741012577,
    "end": 57.669871794264715,
    "text": "E como esse cenário se compara ao de"
  },
  {
    "start": 57.669871794264715,
    "end": 59.47,
    "text": "dois mil e vinte e cinco?"
  }
]