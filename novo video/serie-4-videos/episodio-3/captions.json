[
  {
    "start": 0.2929,
    "end": 4.2558,
    "text": "No Xingu, o fogo não aparece igual"
  },
  {
    "start": 4.2558,
    "end": 5.3647,
    "text": "todos os dias."
  },
  {
    "start": 7.2938,
    "end": 10.7917,
    "text": "Cada barra é um dia."
  },
  {
    "start": 10.7917,
    "end": 14.3464,
    "text": "Algumas se destacam bem mais que as"
  },
  {
    "start": 15.2934,
    "end": 18.7399,
    "text": "Em setembro, o maior pico:"
  },
  {
    "start": 18.7399,
    "end": 22.3103,
    "text": "dia vinte e um, cento e quarenta"
  },
  {
    "start": 22.3103,
    "end": 22.5672,
    "text": "e nove focos."
  },
  {
    "start": 31.2934,
    "end": 34.7254,
    "text": "Em outubro, até o dia vinte e"
  },
  {
    "start": 34.7254,
    "end": 38.4997,
    "text": "seis, o maior foi dia nove:"
  },
  {
    "start": 38.4997,
    "end": 39.5128,
    "text": "trezentos e trinta e seis."
  },
  {
    "start": 42.2984,
    "end": 46.1864,
    "text": "Só Altamira teve cento e quatro nesse"
  },
  {
    "start": 46.1864,
    "end": 48.1238,
    "text": "dia."
  },
  {
    "start": 48.1238,
    "end": 49.83,
    "text": "Focos não medem área queimada."
  },
  {
    "start": 50.2971,
    "end": 54.3514,
    "text": "Houve outros dias altos."
  },
  {
    "start": 54.3514,
    "end": 57.2987,
    "text": "E como isso se compara a dois"
  },
  {
    "start": 57.2987,
    "end": 57.836,
    "text": "mil e vinte e cinco?"
  }
]