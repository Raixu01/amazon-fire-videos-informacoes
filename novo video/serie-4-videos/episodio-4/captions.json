[
  {
    "start": 0.34166427075447264,
    "end": 3.4285733914910153,
    "text": "No Xingu, o que mudou de dois mil"
  },
  {
    "start": 3.4285733914910153,
    "end": 6.284108758018887,
    "text": "e vinte e cinco para dois mil e"
  },
  {
    "start": 6.284108758018887,
    "end": 6.47,
    "text": "vinte e seis?"
  },
  {
    "start": 7.339695823697117,
    "end": 11.621114758612784,
    "text": "Comparando setembro e os mesmos vinte e seis"
  },
  {
    "start": 11.621114758612784,
    "end": 16.033807571200008,
    "text": "dias de outubro, os registros passaram de mil"
  },
  {
    "start": 16.033807571200008,
    "end": 19.854006056486504,
    "text": "cento e treze para três mil seiscentos e"
  },
  {
    "start": 19.854006056486504,
    "end": 21.615548239438375,
    "text": "oitenta e oito:"
  },
  {
    "start": 21.615548239438375,
    "end": 21.83,
    "text": "um aumento de duzentos e trinta e um"
  },
  {
    "start": 22.326627878519485,
    "end": 25.15276632132202,
    "text": "Em dois mil e vinte e cinco, não"
  },
  {
    "start": 25.15276632132202,
    "end": 28.529132598359126,
    "text": "havia El Niño nesse período."
  },
  {
    "start": 28.529132598359126,
    "end": 30.712006135791533,
    "text": "Agora, há."
  },
  {
    "start": 30.712006135791533,
    "end": 34.80258932733545,
    "text": "O fenômeno aumenta o risco climático, mas não"
  },
  {
    "start": 35.3570625,
    "end": 40.671875,
    "text": "A Lei de Crimes Ambientais tipifica provocar incêndio"
  },
  {
    "start": 40.671875,
    "end": 43.42766439909297,
    "text": "em floresta ou em demais formas de vegetação."
  },
  {
    "start": 49.33232379229334,
    "end": 52.68001431871121,
    "text": "O alerta merece atenção."
  },
  {
    "start": 52.68001431871121,
    "end": 56.05119980776601,
    "text": "Acompanhe as orientações oficiais:"
  },
  {
    "start": 56.05119980776601,
    "end": 59.83,
    "text": "prevenir incêndios é proteger a floresta, a saúde"
